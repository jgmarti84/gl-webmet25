# ---------------------------------------------------------------------------
# Database (PostgreSQL / PostGIS)
# ---------------------------------------------------------------------------
# .env is gitignored: never commit it; share it out-of-band, never via git.
# On an existing server, ADD the new lines to your .env — don't overwrite it with
# this file (the optional settings below would change behaviour).
#
# REQUIRED. Password of radar_db (docker compose refuses to start without it).
# It is applied only when the database volume is created: changing it later does
# not change the password of an existing database.
DB_PASSWORD=
# Optional (defaults: radar_prod_db / radar)
# DB_NAME=radar_prod_db
# DB_USER=radar

# Number of open rasterio DatasetReaders cached per render thread.
# Total open file handles = TILE_RENDER_THREADS × DATASET_CACHE_SIZE_PER_THREAD
# Default: 8 threads × 32 datasets = 256 max open file handles
# DATASET_CACHE_SIZE_PER_THREAD=32

# API log level (default: INFO). DEBUG adds per-tile/frame lines (request, colormap,
# render time); INFO logs only slow renders (>= 1000 ms), warnings and errors.
# LOG_LEVEL=INFO

# GDAL Environment (rasterio.Env settings applied at API startup)
# GDAL_CACHEMAX — block cache size in MB (default: 256)
# GDAL_CACHEMAX=256
# VSI_CACHE — enable GDAL virtual filesystem caching (default: true)
# VSI_CACHE=true
# VSI_CACHE_SIZE — per-file VSI cache size in bytes (default: 5000000)
# VSI_CACHE_SIZE=5000000
# GDAL_DISABLE_READDIR_ON_OPEN — prevent slow directory listing on open (default: EMPTY_DIR)
# GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR

# ---------------------------------------------------------------------------
# Redis L2 tile cache
# The API maintains a two-layer tile cache:
#   L1 — in-memory LRUCache (~40 MB, per-process, fastest)
#   L2 — Redis (512 MB, shared across workers, survives restarts)
# ---------------------------------------------------------------------------
# Redis host (must match the service name in docker-compose.yml)
# REDIS_HOST=redis
# Redis port (default: 6379)
# REDIS_PORT=6379
# Redis database index (default: 0)
# REDIS_DB=0
# TTL (seconds) for tiles from past observations — these are immutable (default: 86400 = 24 h)
# REDIS_TILE_TTL_SECONDS=86400
# TTL (seconds) for tiles from recent observations — these may be updated (default: 3600 = 1 h)
# REDIS_TILE_TTL_RECENT_SECONDS=3600
# Kill-switch: set to false to disable Redis without redeploying (default: true)
# REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# Uvicorn worker processes
# ---------------------------------------------------------------------------
# Number of Uvicorn worker processes.
# Each worker has its own ThreadPoolExecutor (TILE_RENDER_THREADS)
# and its own L1 LRU tile cache. All workers share the Redis L2 cache.
# Recommended: 4 for an 8-core server.
# Requires Redis to be running — do not increase without Redis in place.
UVICORN_WORKERS=4
# Extra database connections each worker may open during a peak (default 12), on top of its 10 fixed ones.
# Keep UVICORN_WORKERS x (10 + DB_MAX_OVERFLOW) under about 90: Postgres accepts 100 connections and the
# indexer needs a few. If you raise the workers, lower this (6 workers: DB_MAX_OVERFLOW=5).
# DB_MAX_OVERFLOW=12
# ---------------------------------------------------------------------------
# Frontend version
# ---------------------------------------------------------------------------
# Which frontend to serve through port 80 / Caddy.
# v1 = tile-based (L.tileLayer), v2 = image-based (L.imageOverlay)
FE_VERSION=v2

# ---------------------------------------------------------------------------
# Auth (users + JWT)
# ---------------------------------------------------------------------------
# REQUIRED. Random secret, 32+ characters (the API refuses to start without it):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# true in production (HTTPS); false for local HTTP development
COOKIE_SECURE=true
# REQUIRED in production. Public address(es) of the site, comma separated, exactly as the browser shows them
# (scheme + host + port, no path). Login and every change (POST/PUT/PATCH/DELETE) from any other origin get a 403.
# The compose default is http://localhost: without this line on a server, logging in from the browser fails.
# Local dev: http://localhost,http://localhost:8090
ALLOWED_ORIGINS=http://localhost
# Optional: origins allowed by CORS; empty means the same as ALLOWED_ORIGINS
# CORS_ORIGINS=
# Optional session and lockout settings (defaults shown). Docker compose passes them to the API;
# recreate it with `make api` after changing them. Keep the access token at 15 minutes or more
# while running the e2e/API tests.
# ACCESS_TOKEN_TTL_MINUTES=30
# SESSION_IDLE_TTL_HOURS=48
# SESSION_ABSOLUTE_TTL_DAYS=7
# Closed or expired logins older than this are deleted when that user logs in again
# SESSION_RETENTION_DAYS=90
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# First admin: db-init creates it only if there are no users yet.
# After the first start: make reset-password U=<username>, then remove these two lines.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Sign in with Google (optional; the button only appears when this is set)
# ---------------------------------------------------------------------------
# OAuth client ID (type "Web application") from the Google Cloud console. It is public, not a secret: the login
# page needs it to draw the button. Add every address of the site to its "Authorized JavaScript origins" (the same
# ones as ALLOWED_ORIGINS). Anyone with a Google account can then enter: an account is created for them (viewer,
# mail already verified). Administrators never enter this way. Recreate the API with `make api` after changing it.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Public registration and e-mail (optional; registration is OFF by default)
# ---------------------------------------------------------------------------
# To turn registration on set REGISTRATION_ENABLED=true and fill everything below. Recreate the API with
# `make api` after changing them. Behind a proxy, configure nginx's set_real_ip_from first (limits are per IP).
# REGISTRATION_ENABLED=false
# Public address of the site, used in the links of the mails (no trailing slash)
# PUBLIC_BASE_URL=https://webmet.example.org
# SMTP server of the institutional mail (Gmail/Workspace: use an app password)
# MAIL_HOST=smtp.example.org
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.org
# MAIL_STARTTLS=true
# MAIL_USE_SSL=false
# Terms and privacy policy in the sign-up form. OFF by default: no checkbox, no links, and TERMS_URL / PRIVACY_URL
# are not needed. Turn it on (with both links, provided by the observatory) BEFORE opening the sign-up to the
# public: it is the information and consent notice the data protection law expects when personal data is collected.
# TERMS_REQUIRED=false
# TERMS_URL=
# PRIVACY_URL=
# EMAIL_VERIFY_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60
# Per-account sending caps
# MAIL_MAX_PER_HOUR=3
# MAIL_MIN_INTERVAL_SECONDS=60
# Global sending caps (all accounts together): a fuse against someone signing up many different addresses.
# Past the hourly cap only password recovery goes out; past the daily one nothing does. Keep the daily cap under
# the SMTP provider's limit (Gmail Workspace: about 2,000 a day). Reaching a cap leaves a WARNING in the API log.
# MAIL_MAX_GLOBAL_PER_HOUR=200
# MAIL_MAX_GLOBAL_PER_DAY=1500
